    public function run($argv) {
        if (count($argv) < 2) {
            $this->showHelp();
            return;
        }

        $command = $argv[1];

        switch ($command) {
            case 'make:controller':
                if (!isset($argv[2])) {
                    echo "Error: Controller name is required.\n";
                    echo "Usage: php syntora make:controller ControllerName\n";
                    return;
                }
                $this->makeController($argv[2]);
                break;

            case 'make:model':
                if (!isset($argv[2])) {
                    echo "Error: Model name is required.\n";
                    echo "Usage: php syntora make:model ModelName\n";
                    return;
                }
                $this->makeModel($argv[2]);
                break;

            case 'make:view':
                if (!isset($argv[2])) {
                    echo "Error: View name is required.\n";
                    echo "Usage: php syntora make:view viewName\n";
                    return;
                }
                $this->makeView($argv[2]);
                break;

            case 'list':
                $this->showHelp();
                break;

            default:
                echo "Error: Unknown command '{$command}'\n";
                $this->showHelp();
                break;
        }
    }

    private function makeController($name) {
        // Ensure the name ends with Controller if not already
        if (!str_ends_with(strtolower($name), 'controller')) {
            $name = $name . 'Controller';
        }

        // Capitalize first letter
        $name = ucfirst($name);

        $content = str_replace('{className}', $name, $this->controllerTemplate);
        $path = __DIR__ . '/App/Controllers/' . $name . '.php';

        if (file_exists($path)) {
            echo "Error: Controller '{$name}' already exists.\n";
            return;
        }

        if (!is_dir(__DIR__ . '/App/Controllers')) {
            mkdir(__DIR__ . '/App/Controllers', 0755, true);
        }

        if (file_put_contents($path, $content)) {
            echo "Controller created successfully: {$path}\n";
        } else {
            echo "Error: Could not create controller.\n";
        }
    }

    private function makeModel($name) {
        // Capitalize first letter
        $name = ucfirst($name);
        
        $content = str_replace(
            ['{className}', '{classNameLower}'],
            [$name, strtolower($name)],
            $this->modelTemplate
        );
        
        $path = __DIR__ . '/App/Models/' . $name . '.php';

        if (file_exists($path)) {
            echo "Error: Model '{$name}' already exists.\n";
            return;
        }

        if (!is_dir(__DIR__ . '/App/Models')) {
            mkdir(__DIR__ . '/App/Models', 0755, true);
        }

        if (file_put_contents($path, $content)) {
            echo "Model created successfully: {$path}\n";
        } else {
            echo "Error: Could not create model.\n";
        }
    }

    private function makeView($name) {
        // Remove .php extension if provided
        $name = str_replace('.php', '', $name);
        
        // Convert to lowercase for view files
        $name = strtolower($name);
        
        $content = str_replace('{viewName}', $name, $this->viewTemplate);
        $path = __DIR__ . '/views/' . $name . '.php';

        if (file_exists($path)) {
            echo "Error: View '{$name}' already exists.\n";
            return;
        }

        if (!is_dir(__DIR__ . '/views')) {
            mkdir(__DIR__ . '/views', 0755, true);
        }

        if (file_put_contents($path, $content)) {
            echo "View created successfully: {$path}\n";
        } else {
            echo "Error: Could not create view.\n";
        }
    }

    private function showHelp() {
        echo "Syntora Framework CLI Tool\n\n";
        echo "Available commands:\n";
        
        foreach ($this->commands as $command => $description) {
            echo sprintf("  %-20s %s\n", $command, $description);
        }
    }
